# ── Groq API (get free key at https://console.groq.com) ──────────────────────
GROQ_API_KEY=your_key_here

# ── Postgres (running via Docker) ─────────────────────────────────────────────
# Example: postgresql://postgres:password@localhost:5432/aeroindex
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5433/aeroindex

# ── Pipeline knobs ────────────────────────────────────────────────────────────
# Seconds to wait between requests to the same domain (default: 2)
RATE_LIMIT_DELAY=2

# Index change threshold (%) that triggers spike explanation (default: 5)
SPIKE_THRESHOLD=5.0
